# Copy to .env and fill in. Never commit the real file (it's gitignored).
# Run scripts/bootstrap-gcp.sh first — it creates most of this for you.

# Path to the service account JSON key (from bootstrap-gcp.sh).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# GCP project the service account lives in.
GCP_PROJECT_ID=

# The Training Master Google Sheet's ID, from its URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Must be shared with the service account email as Editor.
SHEET_ID=

# The Drive inbox folder's ID, from its URL:
#   https://drive.google.com/drive/folders/<FOLDER_ID>
# Must be shared with the service account email as Editor. The service
# creates _archive / _quarantine / _duplicates subfolders inside it.
INBOX_FOLDER_ID=

# Local idempotency ledger (content-hash -> processed state). Gitignored.
# LEDGER_PATH=./data/ledger.json

# How often `npm run watch` polls the inbox, in seconds.
# POLL_INTERVAL_SECONDS=90

# debug | info | warn | error
# LOG_LEVEL=info
