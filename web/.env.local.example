# Copy to .env.local for local dev. On Vercel set these under Project → Settings → Environment Variables.

# Required: runs the interviews (server-side only). https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Organiser logins: one passcode per person (8+ characters each). Owners also see costs and the
# activity log. Removing someone, or changing their passcode, signs them out everywhere.
# ORGANISER_ACCOUNTS=[{"id":"tim","name":"Tim","role":"owner","passcode":"..."},{"id":"suzanne","name":"Suzanne","role":"organiser","passcode":"..."}]
# Without ORGANISER_ACCOUNTS, this single passcode is one owner login:
ORGANISER_PASSCODE=choose-a-long-passphrase
# Optional: signs the organiser cookie (defaults to the passcode).
# AUTH_SECRET=

# Storage: added automatically by the Vercel Marketplace "Upstash for Redis" integration.
# Without them the app keeps data in memory (local dev only; lost on restart).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Required in production: members must enter this code (or use the invite link /?code=...).
# Set ALLOW_OPEN_START=1 instead to run deliberately open.
MEMBER_ACCESS_CODE=choose-a-code-for-the-invite-link

# Optional: voice answers via Groq Whisper. Leave unset to hide the microphone.
# GROQ_API_KEY=

# Optional: caps and models.
# MAX_INTERVIEWS=150
# MODEL_INTERVIEW=claude-opus-5-5
# MODEL_REASONING=claude-opus-5-5

# Tests only: replace Claude with a scripted mock.
# AIWD_MOCK_LLM=1

# Optional: email members their report (Resend). Off until both are set; the sending domain must be
# verified in Resend. The organiser chooses in the organiser view whether members are asked for an email.
# RESEND_API_KEY=
# EMAIL_FROM=AI at Work Diagnostic <report@your-domain.example>
# Base for links in emails (defaults to the request's own address).
# PUBLIC_BASE_URL=https://ai-cap-interviewer.vercel.app

# Optional: cost tracking for voice uses this Groq rate in US$ per audio hour (check groq.com/pricing).
# GROQ_PRICE_PER_HOUR=0.111

# Who members can contact (shown on the start page; report-email replies go here unless EMAIL_REPLY_TO is set).
# ORGANISER_CONTACT_NAME=Suzanne
# ORGANISER_CONTACT_EMAIL=
# EMAIL_REPLY_TO=

# Days before survey data (results, emails, report links, activity entries) is deleted. Default 90.
# RETENTION_DAYS=90
