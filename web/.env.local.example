# Copy to .env.local for local dev. On Vercel set these under Project → Settings → Environment Variables.

# Required: runs the interviews (server-side only). https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Required in production: passcode for the organiser pages (/organiser, /network).
ORGANISER_PASSCODE=choose-a-long-passphrase
# Optional: signs the organiser cookie (defaults to the passcode).
# AUTH_SECRET=

# Storage: added automatically by the Vercel Marketplace "Upstash for Redis" integration.
# Without them the app keeps data in memory (local dev only; lost on restart).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Required in production: members must enter this code (or use the invite link /?code=...).
# Set ALLOW_OPEN_START=1 instead to run deliberately open.
MEMBER_ACCESS_CODE=choose-a-code-for-the-invite-link

# Optional: voice answers via Groq Whisper. Leave unset to hide the microphone.
# GROQ_API_KEY=

# Optional: caps and models.
# MAX_INTERVIEWS=150
# MODEL_INTERVIEW=claude-opus-5-5
# MODEL_REASONING=claude-opus-5-5

# Tests only: replace Claude with a scripted mock.
# AIWD_MOCK_LLM=1
