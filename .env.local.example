# Copy to .env.local and fill in. Never commit the real file.

# Anthropic — runs the interviews. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Groq — voice-to-text (Whisper) for respondent + builder. Get a key at
# https://console.groq.com/ and enable Zero Data Retention on the key. Leave unset
# to disable voice input (the mic button simply won't appear).
GROQ_API_KEY=gsk_...
# GROQ_WHISPER_MODEL=whisper-large-v3

# Resend — transactional email for respondent reports. https://resend.com
# Leave unset to disable email: the on-screen summary still works, and the creator's
# "Send aggregate report" action is gated off.
RESEND_API_KEY=re_...
# From address (set the product name here). Resend's test sender in dev; verified domain in prod.
EMAIL_FROM=Research interview <onboarding@resend.dev>

# Supabase — persistence + auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # publishable/anon key (browser-safe)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...            # SECRET — server only, never commit

# Creator allowlist — comma-separated emails allowed to log into /studio
CREATOR_EMAILS=you@example.com

# Spend cap: max interviews per study before respondents see "study full"
# MAX_INTERVIEWS=300

# Optional model overrides (defaults: Sonnet for interviews, Opus for plan/synthesis)
# MODEL_INTERVIEW=claude-sonnet-4-6
# MODEL_REASONING=claude-opus-4-8

# Landscape Scanner — the scan engine runs as a separate Python service (on the NUC,
# behind a Cloudflare Tunnel), not in this app. See docs/scanner-service-contract.md.
# Leave SCANNER_SERVICE_URL unset to disable scanning (the feature simply won't appear).
# SCANNER_SERVICE_URL=https://scanner.alignedstudies.org
# SCANNER_SERVICE_TOKEN=                 # app bearer token the engine validates
# Cloudflare Access service token (if the tunnel is fronted by Access):
# SCANNER_CF_ACCESS_CLIENT_ID=
# SCANNER_CF_ACCESS_CLIENT_SECRET=
# Per-scan budget (creator's own key): default and server-enforced max in USD.
# SCAN_BUDGET_DEFAULT=2
# SCAN_BUDGET_MAX=5
# Per-creator fair-share: max scans one creator may have running at once.
# SCAN_MAX_ACTIVE=3
